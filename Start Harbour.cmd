@echo off
cd /d "%~dp0"
powershell.exe -NoProfile -Command "$taskUrl='http://127.0.0.1:4173'; try { $taskResponse=Invoke-WebRequest -Uri $taskUrl -UseBasicParsing -TimeoutSec 2; if ($taskResponse.Content -match 'Harbour') { Start-Process $taskUrl; exit 0 }; throw 'Port 4173 is used by a different program.' } catch { if ($_.Exception.Message -eq 'Port 4173 is used by a different program.') { Write-Error $_; exit 1 } }; $taskNode=(Get-Command node.exe -ErrorAction Stop).Source; Start-Process -FilePath $taskNode -ArgumentList 'server.mjs --production' -WorkingDirectory (Get-Location).Path -WindowStyle Hidden; for ($taskAttempt=0;$taskAttempt -lt 25;$taskAttempt++) { Start-Sleep -Milliseconds 400; try { $taskResponse=Invoke-WebRequest -Uri $taskUrl -UseBasicParsing -TimeoutSec 1; if ($taskResponse.Content -match 'Harbour') { Start-Process $taskUrl; exit 0 } } catch {} }; Write-Error 'Harbour could not start. Run npm start in this folder to see the error.'; exit 1"
if errorlevel 1 pause
